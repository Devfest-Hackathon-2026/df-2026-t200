# どちらか一方を設定する（両方未設定ならデモモードで起動）

# A. Gemini API キー（ローカル開発向け。Google AI Studio で発行。※Cloud Credit は適用されない）
GEMINI_API_KEY=

# B. Vertex AI（Cloud Credit が使える。事前に `gcloud auth application-default login` が必要）
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# モデル（期間中に入れ替わる可能性があるため変更可能）
ANALYSIS_MODEL=gemini-3.6-flash
QA_MODEL=gemini-3.6-flash

# DEMO_MODE=1   # キーがあってもサンプルデータで動かす
# MAX_UPLOAD_MB=20
# MAX_PAGES=100
